<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if pageTitle %}{{ pageTitle }} | {{ content.header.logoLine1 }} {{ content.header.logoLine2 }}{% else %}{{ content.site.title }}{% endif %}</title>
  <meta name="description" content="{{ content.site.description }}" />

  <!-- Favicon -->
  <link rel="icon" href="/images/favicon.ico" sizes="any" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['Playfair Display', 'Georgia', 'serif'],
            sans:  ['Inter', 'system-ui', 'sans-serif'],
          },
          colors: {
            forest: '{{ colors.dark }}',
            sage:   '{{ colors.accent }}',
            stone:  '{{ colors.light }}',
            cream:  '{{ colors.cream }}',
          },
        },
      },
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <style>
    html { scroll-padding-top: 72px; }
    .service-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .service-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(28,53,83,0.12); }
    .step-connector { flex: 1; height: 2px; background: {{ colors.accent }}; opacity: 0.4; margin-top: -1.5rem; }
    .photo-placeholder { background: linear-gradient(135deg, {{ colors.accent }}22 0%, {{ colors.dark }}22 100%); }
    #mobile-menu { transition: max-height 0.3s ease, opacity 0.3s ease; }
    #more-toggle svg, #more-toggle-mobile svg { transition: transform 0.2s ease; }
    #more-toggle[aria-expanded="true"] svg,
    #more-toggle-mobile[aria-expanded="true"] svg { transform: rotate(180deg); }
    .divider { width: 48px; height: 3px; background: {{ colors.accent }}; }
  </style>
</head>

<body class="font-sans bg-white text-gray-800 antialiased">

  <!-- ═══════════════════════════════════════════════
       STICKY NAVIGATION
  ════════════════════════════════════════════════ -->
  <header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-[72px]">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          {% if content.header.logoImage %}
          <img src="{{ content.header.logoImage }}" alt="" width="40" height="40" class="w-10 h-10 object-contain flex-shrink-0" />
          {% else %}
          <span class="w-8 h-8 rounded-full bg-forest flex items-center justify-center flex-shrink-0">
            <i data-lucide="{{ content.header.logoIcon }}" class="text-sage w-4 h-4"></i>
          </span>
          {% endif %}
          <span class="font-serif text-forest text-lg font-semibold leading-tight">
            {{ content.header.logoLine1 }}<br><span class="font-normal text-sm text-sage">{{ content.header.logoLine2 }}</span>
          </span>
        </a>

        <!-- Desktop links -->
        <div class="hidden md:flex items-center gap-8">
          {% for link in content.nav %}
          <a href="/#{{ link.anchor }}" class="text-sm text-gray-600 hover:text-forest transition-colors">{{ link.label }}</a>
          {% endfor %}

          <!-- More dropdown -->
          <div class="relative" id="more-menu">
            <button type="button" id="more-toggle"
              class="flex items-center gap-1 text-sm text-gray-600 hover:text-forest transition-colors"
              aria-expanded="false" aria-haspopup="true" aria-controls="more-panel">
              More
              <i data-lucide="chevron-down" class="w-3.5 h-3.5 transition-transform duration-200" id="more-chevron"></i>
            </button>
            <div id="more-panel"
              class="hidden absolute right-0 top-full mt-3 w-56 bg-white border border-gray-200 rounded shadow-lg py-2">
              {% for item in newPages %}
              <a href="/{{ item.slug }}/"
                class="block px-4 py-2 text-sm text-gray-600 hover:text-forest hover:bg-stone transition-colors">{{ item.title }}</a>
              {% endfor %}
            </div>
          </div>

          <a href="/#contact" class="inline-flex items-center gap-1.5 bg-forest text-white text-sm font-medium px-5 py-2 rounded hover:bg-sage transition-colors">
            <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
            {{ content.hero.primaryButton }}
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button id="nav-toggle" class="md:hidden p-2 rounded text-forest hover:bg-stone transition-colors" aria-label="Toggle menu" aria-expanded="false">
          <i data-lucide="menu" class="w-5 h-5" id="nav-icon"></i>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden overflow-hidden max-h-0 opacity-0">
        <div class="py-4 space-y-1 border-t border-gray-100">
          {% for link in content.nav %}
          <a href="/#{{ link.anchor }}" class="block px-2 py-2 text-gray-700 hover:text-forest hover:bg-stone rounded transition-colors mobile-link">{{ link.label }}</a>
          {% endfor %}

          <!-- More (collapsible) -->
          <button type="button" id="more-toggle-mobile"
            class="w-full flex items-center justify-between px-2 py-2 text-gray-700 hover:text-forest hover:bg-stone rounded transition-colors"
            aria-expanded="false" aria-controls="more-panel-mobile">
            More
            <i data-lucide="chevron-down" class="w-4 h-4 transition-transform duration-200" id="more-chevron-mobile"></i>
          </button>
          <div id="more-panel-mobile" class="hidden pl-3 border-l border-gray-100 ml-2">
            {% for item in newPages %}
            <a href="/{{ item.slug }}/"
              class="block px-2 py-2 text-sm text-gray-600 hover:text-forest hover:bg-stone rounded transition-colors mobile-link">{{ item.title }}</a>
            {% endfor %}
          </div>

          <div class="pt-2">
            <a href="/#contact" class="inline-flex items-center gap-1.5 bg-forest text-white text-sm font-medium px-5 py-2 rounded mobile-link">
              <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
              {{ content.hero.primaryButton }}
            </a>
          </div>
        </div>
      </div>
    </nav>
  </header>
