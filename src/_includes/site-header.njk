<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if pageTitle %}{{ pageTitle }} | {{ content.header.logoLine1 }} {{ content.header.logoLine2 }}{% else %}{{ content.site.title }}{% endif %}</title>
  <meta name="description" content="{{ content.site.description }}" />

  <!-- Favicon -->
  <link rel="icon" href="/images/favicon.ico" sizes="any" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['Playfair Display', 'Georgia', 'serif'],
            sans:  ['Inter', 'system-ui', 'sans-serif'],
          },
          colors: {
            forest: '{{ colors.dark }}',
            sage:   '{{ colors.accent }}',
            stone:  '{{ colors.light }}',
            cream:  '{{ colors.cream }}',
          },
        },
      },
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <style>
    html { scroll-padding-top: 72px; }
    .service-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .service-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(28,53,83,0.12); }
    .step-connector { flex: 1; height: 2px; background: {{ colors.accent }}; opacity: 0.4; margin-top: -1.5rem; }
    .photo-placeholder { background: linear-gradient(135deg, {{ colors.accent }}22 0%, {{ colors.dark }}22 100%); }
    #nav-menu { transform-origin: top right; }
    #nav-menu:not(.hidden) { animation: navMenuIn 0.15s ease-out; }
    @keyframes navMenuIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { #nav-menu:not(.hidden) { animation: none; } }
    .divider { width: 48px; height: 3px; background: {{ colors.accent }}; }
  </style>
</head>

<body class="font-sans bg-white text-gray-800 antialiased">

  <!-- ═══════════════════════════════════════════════
       STICKY NAVIGATION
  ════════════════════════════════════════════════ -->
  <header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative flex items-center justify-between h-[72px]">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          {% if content.header.logoImage %}
          <img src="{{ content.header.logoImage }}" alt="" width="40" height="40" class="w-10 h-10 object-contain flex-shrink-0" />
          {% else %}
          <span class="w-8 h-8 rounded-full bg-forest flex items-center justify-center flex-shrink-0">
            <i data-lucide="{{ content.header.logoIcon }}" class="text-sage w-4 h-4"></i>
          </span>
          {% endif %}
          <span class="font-serif text-forest text-lg font-semibold leading-tight">
            {{ content.header.logoLine1 }}<br><span class="font-normal text-sm text-sage">{{ content.header.logoLine2 }}</span>
          </span>
        </a>

        <!-- Right-hand controls -->
        <div class="flex items-center gap-3">
          <a href="/#contact" class="hidden sm:inline-flex items-center gap-1.5 bg-forest text-white text-sm font-medium px-5 py-2 rounded hover:bg-sage transition-colors whitespace-nowrap">
            <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
            {{ content.hero.primaryButton }}
          </a>

          <button id="nav-toggle"
            class="flex items-center gap-2 p-2 rounded text-forest hover:bg-stone transition-colors"
            aria-label="Menu" aria-expanded="false" aria-controls="nav-menu" aria-haspopup="true">
            <span class="hidden sm:inline text-sm font-medium">Menu</span>
            <i data-lucide="menu" class="w-5 h-5" id="nav-icon"></i>
          </button>
        </div>

        <!-- Menu panel — one flat list, same behaviour at every width -->
        <div id="nav-menu"
          class="hidden absolute right-0 top-full w-64 max-w-[calc(100vw-2rem)] bg-white border border-gray-200 rounded-b rounded-tl shadow-lg py-2">
          {% for link in mainNav %}
          <a href="{{ link.href }}" class="block px-4 py-2.5 text-sm text-gray-700 hover:text-forest hover:bg-stone transition-colors nav-link">{{ link.label }}</a>
          {% endfor %}

          <div class="sm:hidden px-3 pt-3 pb-1 mt-1 border-t border-gray-100">
            <a href="/#contact" class="flex w-full items-center justify-center gap-1.5 bg-forest text-white text-sm font-medium px-3 py-2.5 rounded nav-link">
              <i data-lucide="calendar" class="w-3.5 h-3.5 flex-shrink-0"></i>
              {{ content.hero.primaryButton }}
            </a>
          </div>
        </div>
      </div>
    </nav>
  </header>
