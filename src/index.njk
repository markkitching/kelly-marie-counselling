<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ content.site.title }}</title>
  <meta name="description" content="{{ content.site.description }}" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['Playfair Display', 'Georgia', 'serif'],
            sans:  ['Inter', 'system-ui', 'sans-serif'],
          },
          colors: {
            forest: '#1c3553',
            sage:   '#4a7fa5',
            stone:  '#f5f7fa',
            cream:  '#e8eef5',
          },
        },
      },
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <style>
    html { scroll-padding-top: 72px; }
    .service-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .service-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(28,53,83,0.12); }
    .step-connector { flex: 1; height: 2px; background: #4a7fa5; opacity: 0.4; margin-top: -1.5rem; }
    .photo-placeholder { background: linear-gradient(135deg, #4a7fa522 0%, #1c355322 100%); }
    #mobile-menu { transition: max-height 0.3s ease, opacity 0.3s ease; }
    .divider { width: 48px; height: 3px; background: #4a7fa5; }
  </style>
</head>

<body class="font-sans bg-white text-gray-800 antialiased">

  <!-- ═══════════════════════════════════════════════
       STICKY NAVIGATION
  ════════════════════════════════════════════════ -->
  <header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-[72px]">

        <!-- Logo -->
        <a href="#home" class="flex items-center gap-2.5 group">
          <span class="w-8 h-8 rounded-full bg-forest flex items-center justify-center flex-shrink-0">
            <i data-lucide="{{ content.header.logoIcon }}" class="text-sage w-4 h-4"></i>
          </span>
          <span class="font-serif text-forest text-lg font-semibold leading-tight">
            {{ content.header.logoLine1 }}<br><span class="font-normal text-sm text-sage">{{ content.header.logoLine2 }}</span>
          </span>
        </a>

        <!-- Desktop links -->
        <div class="hidden md:flex items-center gap-8">
          {% for link in content.nav %}
          <a href="#{{ link.anchor }}" class="text-sm text-gray-600 hover:text-forest transition-colors">{{ link.label }}</a>
          {% endfor %}
          <a href="#contact" class="inline-flex items-center gap-1.5 bg-forest text-white text-sm font-medium px-5 py-2 rounded hover:bg-sage transition-colors">
            <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
            {{ content.hero.primaryButton }}
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button id="nav-toggle" class="md:hidden p-2 rounded text-forest hover:bg-stone transition-colors" aria-label="Toggle menu" aria-expanded="false">
          <i data-lucide="menu" class="w-5 h-5" id="nav-icon"></i>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden overflow-hidden max-h-0 opacity-0">
        <div class="py-4 space-y-1 border-t border-gray-100">
          {% for link in content.nav %}
          <a href="#{{ link.anchor }}" class="block px-2 py-2 text-gray-700 hover:text-forest hover:bg-stone rounded transition-colors mobile-link">{{ link.label }}</a>
          {% endfor %}
          <div class="pt-2">
            <a href="#contact" class="inline-flex items-center gap-1.5 bg-forest text-white text-sm font-medium px-5 py-2 rounded mobile-link">
              <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
              {{ content.hero.primaryButton }}
            </a>
          </div>
        </div>
      </div>
    </nav>
  </header>


  <!-- ═══════════════════════════════════════════════ HERO ═══════════════════════════════════════════════ -->
  <section id="home" class="bg-stone min-h-[calc(100vh-72px)] flex items-center">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid md:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div class="order-2 md:order-1">
        <div class="flex items-center gap-2 mb-6">
          <span class="w-px h-5 bg-sage"></span>
          <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ content.hero.eyebrow }}</span>
        </div>
        <h1 class="font-serif text-forest text-5xl lg:text-6xl leading-tight mb-4">
          {{ content.hero.headingLead }}<br><em>{{ content.hero.headingEmphasis }}</em>
        </h1>
        <div class="divider mb-6"></div>
        <p class="text-gray-600 text-lg leading-relaxed mb-4">
          {{ content.hero.paragraph1 }}
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          {{ content.hero.paragraph2 }}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#contact" class="inline-flex items-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            {{ content.hero.primaryButton }}
          </a>
          <a href="#services" class="inline-flex items-center gap-2 border border-forest text-forest font-medium px-6 py-3 rounded hover:bg-forest hover:text-white transition-colors">
            {{ content.hero.secondaryButton }}
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </a>
        </div>
      </div>

      <!-- Photo slot -->
      <div class="order-1 md:order-2 flex justify-center">
        <div class="relative w-full max-w-sm">
          <div class="absolute -top-4 -right-4 w-full h-full rounded-lg bg-sage/10 -z-10"></div>
          <div class="aspect-[3/4] rounded-lg overflow-hidden bg-sage/10 photo-placeholder flex items-center justify-center relative">
            <img
              src="{{ content.hero.image }}"
              alt="Kelly Marie — Leeds Psychotherapist"
              class="w-full h-full object-cover object-top"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <div class="hidden flex-col items-center justify-center gap-3 text-sage/60 p-8 text-center absolute inset-0">
              <i data-lucide="user" class="w-16 h-16"></i>
              <p class="text-sm font-medium">Add a hero photo in the editor</p>
            </div>
          </div>
          <!-- Badge -->
          <div class="absolute -bottom-4 -left-4 bg-white rounded shadow-lg px-4 py-3 flex items-center gap-2 border border-gray-100">
            <span class="w-8 h-8 bg-sage/15 rounded flex items-center justify-center">
              <i data-lucide="award" class="w-4 h-4 text-forest"></i>
            </span>
            <div class="leading-tight">
              <div class="text-xs text-gray-500">Accredited</div>
              <div class="text-sm font-semibold text-forest">BACP Member</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SECTIONS — order controlled by content.sectionOrder
  ════════════════════════════════════════════════ -->
  {% for sectionName in content.sectionOrder %}

  {% if sectionName == "about" %}
  <!-- ═══ ABOUT KELLY ═══ -->
  <section id="about" class="bg-white py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid md:grid-cols-2 gap-16 items-center">

        <!-- Photo slot -->
        <div class="relative">
          <div class="aspect-square rounded-lg overflow-hidden photo-placeholder flex items-center justify-center">
            <img
              src="{{ content.about.image }}"
              alt="Kelly Marie in her therapy room"
              class="w-full h-full object-cover"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <div class="hidden w-full h-full flex-col items-center justify-center gap-3 text-sage/60 p-8 text-center">
              <i data-lucide="image" class="w-12 h-12"></i>
              <p class="text-sm font-medium">Add an about photo in the editor</p>
            </div>
          </div>
          <div class="absolute -bottom-6 -right-6 w-32 h-32 rounded bg-sage/10 -z-10"></div>
          <div class="absolute -top-6 -left-6 w-20 h-20 rounded bg-forest/10 -z-10"></div>
        </div>

        <!-- Text -->
        <div>
          <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ content.about.eyebrow }}</span>
          <h2 class="font-serif text-forest text-4xl mt-2 mb-4">{{ content.about.headingLead }} <em>{{ content.about.headingEmphasis }}</em></h2>
          <div class="divider mb-6"></div>

          <p class="text-gray-600 leading-relaxed mb-4">
            {{ content.about.paragraph1 }}
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            {{ content.about.paragraph2 }}
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            {{ content.about.paragraph3 }}
          </p>

          <!-- Credential badges -->
          <div class="flex flex-wrap gap-3">
            {% for badge in content.about.badges %}
            <div class="flex items-center gap-2 bg-stone border border-gray-200 px-4 py-2.5 rounded">
              <i data-lucide="{{ badge.icon }}" class="w-4 h-4 text-sage"></i>
              <span class="text-sm font-medium text-forest">{{ badge.label }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  {% elif sectionName == "services" %}
  <!-- ═══ SERVICES ═══ -->
  <section id="services" class="bg-stone py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-16">
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ content.services.eyebrow }}</span>
        <h2 class="font-serif text-forest text-4xl mt-2">{{ content.services.heading }}</h2>
        <div class="divider mt-4 mb-4"></div>
        <p class="text-gray-600 max-w-xl leading-relaxed">
          {{ content.services.intro }}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for card in content.services.cards %}
        <div class="service-card bg-white rounded-lg p-6 border-t-4 border-sage border border-gray-100">
          <div class="w-10 h-10 bg-stone rounded flex items-center justify-center mb-4">
            <i data-lucide="{{ card.icon }}" class="w-5 h-5 text-forest"></i>
          </div>
          <h3 class="font-serif text-forest text-xl mb-2">{{ card.title }}</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            {{ card.description }}
          </p>
          <p class="text-xs text-sage font-semibold uppercase tracking-wide">{{ card.meta }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% elif sectionName == "approach" %}
  <!-- ═══ THERAPEUTIC APPROACH ═══ -->
  <section id="approach" class="bg-forest py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-16">
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ content.approach.eyebrow }}</span>
        <h2 class="font-serif text-white text-4xl mt-2">{{ content.approach.heading }}</h2>
        <div class="divider mt-4 mb-4" style="background: #4a7fa5;"></div>
        <p class="text-white/60 max-w-xl leading-relaxed">
          {{ content.approach.intro }}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {% for item in content.approach.items %}
        <div class="bg-white/5 rounded-lg p-8 border border-white/10">
          <div class="w-12 h-12 bg-white/10 rounded flex items-center justify-center mb-6">
            <i data-lucide="{{ item.icon }}" class="w-6 h-6 text-sage"></i>
          </div>
          <h3 class="font-serif text-white text-xl mb-3">{{ item.title }}</h3>
          <p class="text-white/60 text-sm leading-relaxed">
            {{ item.description }}
          </p>
        </div>
        {% endfor %}
      </div>

      <!-- Quote -->
      <div class="mt-16 pt-12 border-t border-white/10 text-center">
        <blockquote class="font-serif italic text-white/70 text-xl max-w-2xl mx-auto leading-relaxed">
          {{ content.approach.quote }}
        </blockquote>
        <cite class="text-sage text-sm mt-3 block not-italic">{{ content.approach.quoteAuthor }}</cite>
      </div>

    </div>
  </section>

  {% elif sectionName == "process" %}
  <!-- ═══ THE PROCESS ═══ -->
  <section id="process" class="bg-stone py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-16">
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ content.process.eyebrow }}</span>
        <h2 class="font-serif text-forest text-4xl mt-2">{{ content.process.heading }}</h2>
        <div class="divider mt-4 mb-4"></div>
        <p class="text-gray-600 max-w-xl leading-relaxed">
          {{ content.process.intro }}
        </p>
      </div>

      <!-- Steps — desktop: horizontal -->
      <div class="hidden md:flex items-start gap-0">
        {% for step in content.process.steps %}
        {% if not loop.first %}<div class="step-connector mt-7"></div>{% endif %}
        <div class="flex-1 text-center px-4">
          <div class="w-14 h-14 bg-forest text-white rounded flex items-center justify-center mx-auto mb-4 font-serif text-xl font-semibold shadow-md">{{ loop.index }}</div>
          <h3 class="font-serif text-forest text-lg mb-2">{{ step.title }}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{{ step.description }}</p>
        </div>
        {% endfor %}
      </div>

      <!-- Steps — mobile: vertical -->
      <div class="md:hidden space-y-8">
        {% for step in content.process.steps %}
        <div class="flex gap-5 items-start">
          <div class="w-12 h-12 bg-forest text-white rounded flex items-center justify-center flex-shrink-0 font-serif text-lg font-semibold shadow-md">{{ loop.index }}</div>
          <div>
            <h3 class="font-serif text-forest text-lg mb-1">{{ step.title }}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{{ step.description }}</p>
          </div>
        </div>
        {% endfor %}
      </div>

    </div>
  </section>

  {% elif sectionName == "contact" %}
  <!-- ═══ CONTACT ═══ -->
  <section id="contact" class="bg-white py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-16">
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ content.contact.eyebrow }}</span>
        <h2 class="font-serif text-forest text-4xl mt-2">{{ content.contact.heading }}</h2>
        <div class="divider mt-4 mb-4"></div>
        <p class="text-gray-600 max-w-xl leading-relaxed">
          {{ content.contact.intro }}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-start">

        <!-- Contact info -->
        <div>
          <div class="space-y-6 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-stone border border-gray-200 rounded flex items-center justify-center flex-shrink-0 mt-0.5">
                <i data-lucide="mail" class="w-5 h-5 text-forest"></i>
              </div>
              <div>
                <div class="text-sm font-semibold text-forest mb-0.5">Email</div>
                <a href="mailto:{{ content.contact.email }}" class="text-gray-600 hover:text-forest transition-colors">{{ content.contact.email }}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-stone border border-gray-200 rounded flex items-center justify-center flex-shrink-0 mt-0.5">
                <i data-lucide="map-pin" class="w-5 h-5 text-forest"></i>
              </div>
              <div>
                <div class="text-sm font-semibold text-forest mb-0.5">Location</div>
                <p class="text-gray-600">{{ content.contact.locationLine1 }}<br><span class="text-sm text-gray-500">{{ content.contact.locationLine2 }}</span></p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-stone border border-gray-200 rounded flex items-center justify-center flex-shrink-0 mt-0.5">
                <i data-lucide="clock" class="w-5 h-5 text-forest"></i>
              </div>
              <div>
                <div class="text-sm font-semibold text-forest mb-0.5">Availability</div>
                <p class="text-gray-600">{{ content.contact.availability }}</p>
              </div>
            </div>
          </div>

          <!-- Confidentiality note -->
          <div class="bg-stone rounded-lg p-6 border border-gray-200">
            <div class="flex items-center gap-2 mb-2">
              <i data-lucide="shield" class="w-4 h-4 text-sage"></i>
              <span class="text-sm font-semibold text-forest">{{ content.contact.confidentialityTitle }}</span>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed">
              {{ content.contact.confidentialityText }}
            </p>
          </div>
        </div>

        <!-- Formspree form -->
        <form
          id="contact-form"
          action="{{ content.site.formspreeEndpoint }}"
          method="POST"
          class="bg-white rounded-lg border border-gray-200 shadow-sm p-8 space-y-5"
        >
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-forest mb-1.5">Full Name <span class="text-sage">*</span></label>
              <input type="text" id="name" name="name" required
                class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-sage/40 focus:border-sage transition-colors"
                placeholder="Your name" />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-forest mb-1.5">Email Address <span class="text-sage">*</span></label>
              <input type="email" id="email" name="email" required
                class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-sage/40 focus:border-sage transition-colors"
                placeholder="you@example.com" />
            </div>
          </div>

          <div>
            <label for="phone" class="block text-sm font-semibold text-forest mb-1.5">Phone <span class="text-gray-400 font-normal">(optional)</span></label>
            <input type="tel" id="phone" name="phone"
              class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-sage/40 focus:border-sage transition-colors"
              placeholder="07700 000 000" />
          </div>

          <div>
            <label for="service" class="block text-sm font-semibold text-forest mb-1.5">Service of Interest</label>
            <select id="service" name="service"
              class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 bg-white focus:outline-none focus:ring-2 focus:ring-sage/40 focus:border-sage transition-colors">
              <option value="">Select a service (optional)</option>
              {% for card in content.services.cards %}
              <option>{{ card.title }}</option>
              {% endfor %}
              <option>Not sure yet</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-forest mb-1.5">Message <span class="text-sage">*</span></label>
            <textarea id="message" name="message" rows="5" required
              class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-sage/40 focus:border-sage transition-colors resize-none"
              placeholder="Briefly describe what has prompted you to seek support, or simply introduce yourself."></textarea>
          </div>

          <div>
            <label for="heard" class="block text-sm font-semibold text-forest mb-1.5">How did you hear about me?</label>
            <select id="heard" name="heard_about"
              class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 bg-white focus:outline-none focus:ring-2 focus:ring-sage/40 focus:border-sage transition-colors">
              <option value="">Please select (optional)</option>
              <option>Google / web search</option>
              <option>Psychology Today</option>
              <option>BACP directory</option>
              <option>Word of mouth / referral</option>
              <option>Social media</option>
              <option>GP / healthcare professional</option>
              <option>Other</option>
            </select>
          </div>

          <!-- Consent checkbox -->
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="consent" required
              class="mt-0.5 w-4 h-4 accent-forest rounded flex-shrink-0" />
            <span class="text-xs text-gray-500 leading-relaxed">
              I consent to Kelly Marie Counselling storing my details to respond to my enquiry. Your information will never be shared with third parties and will be held in line with GDPR.
            </span>
          </label>

          <button type="submit" id="submit-btn"
            class="w-full bg-forest text-white font-medium py-3.5 rounded hover:bg-sage transition-colors flex items-center justify-center gap-2">
            <i data-lucide="send" class="w-4 h-4"></i>
            Submit Enquiry
          </button>

          <!-- Status messages -->
          <div id="form-success" class="hidden text-center py-3 px-4 bg-sage/10 border border-sage/20 rounded">
            <p class="text-forest text-sm font-semibold">Enquiry received — thank you.</p>
            <p class="text-gray-600 text-xs mt-1">I will be in touch within one working day.</p>
          </div>
          <div id="form-error" class="hidden text-center py-3 px-4 bg-red-50 border border-red-100 rounded">
            <p class="text-red-700 text-sm font-semibold">Submission failed.</p>
            <p class="text-gray-600 text-xs mt-1">Please try again or email me directly.</p>
          </div>

        </form>
      </div>
    </div>
  </section>

  {% endif %}
  {% endfor %}


  <!-- ═══════════════════════════════════════════════ FOOTER ═══════════════════════════════════════════════ -->
  <footer class="bg-forest text-white py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid md:grid-cols-3 gap-10 pb-10 border-b border-white/10">

        <!-- Brand -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
              <i data-lucide="{{ content.header.logoIcon }}" class="text-sage w-4 h-4"></i>
            </span>
            <span class="font-serif text-white text-lg">{{ content.header.logoLine1 }} {{ content.header.logoLine2 }}</span>
          </div>
          <p class="text-white/50 text-sm leading-relaxed mb-4">
            {{ content.footer.tagline }}
          </p>
          <!-- BACP badge -->
          <div class="inline-flex items-center gap-2 bg-white/10 rounded px-3 py-2">
            <i data-lucide="award" class="w-4 h-4 text-sage"></i>
            <div class="text-xs leading-tight">
              <div class="text-white font-medium">BACP Registered Member</div>
              <div class="text-white/50">{{ content.footer.bacpNumber }}</div>
            </div>
          </div>
        </div>

        <!-- Quick links -->
        <div>
          <h4 class="font-serif text-white text-base mb-4">Quick Links</h4>
          <ul class="space-y-2">
            {% for link in content.nav %}
            <li><a href="#{{ link.anchor }}" class="text-white/50 hover:text-sage text-sm transition-colors">{{ link.label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="font-serif text-white text-base mb-4">Contact</h4>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2 text-white/50 text-sm">
              <i data-lucide="mail" class="w-3.5 h-3.5 text-sage"></i>
              <a href="mailto:{{ content.contact.email }}" class="hover:text-sage transition-colors">{{ content.contact.email }}</a>
            </li>
            <li class="flex items-center gap-2 text-white/50 text-sm">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-sage"></i>
              <span>{{ content.contact.locationLine1 }}</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Bottom bar -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/30">
        <p>&copy; <span id="year"></span> {{ content.header.logoLine1 }} {{ content.header.logoLine2 }}. All rights reserved.</p>
        <p>All client information treated in strict confidence in accordance with BACP ethical guidelines.</p>
      </div>

    </div>
  </footer>


  <!-- ═══════════════════════════════════════════════ JAVASCRIPT ═══════════════════════════════════════════════ -->
  <script>
    lucide.createIcons();
    document.getElementById('year').textContent = new Date().getFullYear();

    // ── Mobile nav toggle ──────────────────────────
    const navToggle  = document.getElementById('nav-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const navIcon    = document.getElementById('nav-icon');
    let menuOpen = false;

    navToggle.addEventListener('click', () => {
      menuOpen = !menuOpen;
      navToggle.setAttribute('aria-expanded', menuOpen);
      if (menuOpen) {
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
        mobileMenu.style.opacity  = '1';
        navIcon.setAttribute('data-lucide', 'x');
      } else {
        mobileMenu.style.maxHeight = '0';
        mobileMenu.style.opacity   = '0';
        navIcon.setAttribute('data-lucide', 'menu');
      }
      lucide.createIcons();
    });

    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        menuOpen = false;
        mobileMenu.style.maxHeight = '0';
        mobileMenu.style.opacity   = '0';
        navIcon.setAttribute('data-lucide', 'menu');
        navToggle.setAttribute('aria-expanded', 'false');
        lucide.createIcons();
      });
    });

    // ── Formspree async submission ─────────────────
    const form       = document.getElementById('contact-form');
    const submitBtn  = document.getElementById('submit-btn');
    const successMsg = document.getElementById('form-success');
    const errorMsg   = document.getElementById('form-error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (form.action.includes('YOUR_FORM_ID')) {
        errorMsg.classList.remove('hidden');
        errorMsg.querySelector('p').textContent = 'Contact form not yet configured — see README.';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<svg class="animate-spin w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg> Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body:   new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.reset();
          successMsg.classList.remove('hidden');
          errorMsg.classList.add('hidden');
          submitBtn.style.display = 'none';
        } else {
          throw new Error('Server error');
        }
      } catch {
        errorMsg.classList.remove('hidden');
        successMsg.classList.add('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-lucide="send" class="w-4 h-4"></i> Submit Enquiry';
        lucide.createIcons();
      }
    });
  </script>

</body>
</html>
