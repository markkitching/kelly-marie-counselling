---
pagination:
  data: newPages
  size: 1
  alias: page_item
permalink: "/{{ page_item.slug }}/"
eleventyComputed:
  pageTitle: "{{ page_item.title | safe }}"
---
{%- set pageContent = pages[page_item.slug] or {} -%}
{%- set hasContent = pageContent.body or pageContent.intro -%}
{% include "site-header.njk" %}

{% if hasContent %}
  <!-- ═══════════════════════════════════════════════ PAGE ═══════════════════════════════════════════════ -->
  <section class="bg-stone py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      {% if pageContent.eyebrow %}
      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="w-px h-5 bg-sage"></span>
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ pageContent.eyebrow }}</span>
        <span class="w-px h-5 bg-sage"></span>
      </div>
      {% endif %}
      <h1 class="font-serif text-forest text-4xl lg:text-5xl leading-tight">
        {{ pageContent.heading or page_item.title }}
      </h1>
      <div class="divider mt-6 mx-auto"></div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="{% if pageContent.image %}grid md:grid-cols-2 gap-12 items-start{% else %}max-w-3xl mx-auto{% endif %}">

        <div>
          {% if pageContent.intro %}
          <p class="text-gray-600 text-lg leading-relaxed mb-6">{{ pageContent.intro }}</p>
          {% endif %}
          {% if pageContent.body %}
          <div class="text-gray-600 leading-relaxed">{{ pageContent.body | nl2br | safe }}</div>
          {% endif %}
        </div>

        {% if pageContent.image %}
        <div class="rounded-lg overflow-hidden">
          <!-- Capped so a tall portrait photo can't tower over a short block of text. -->
          <img src="{{ pageContent.image }}" alt="" class="w-full max-h-[520px] object-cover" />
        </div>
        {% endif %}

      </div>

      <div class="flex flex-wrap gap-4 justify-center mt-16">
        <a href="/#contact" class="inline-flex items-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors">
          <i data-lucide="calendar" class="w-4 h-4"></i>
          {{ content.hero.primaryButton }}
        </a>
        <a href="/" class="inline-flex items-center gap-2 border border-forest text-forest font-medium px-6 py-3 rounded hover:bg-forest hover:text-white transition-colors">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Back to home
        </a>
      </div>
    </div>
  </section>

{% else %}
  <!-- ═══════════════════════════════════════════════ HOLDING PAGE ═══════════════════════════════════════════════ -->
  <section class="bg-stone min-h-[calc(100vh-72px)] flex items-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">

      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="w-px h-5 bg-sage"></span>
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">Coming soon</span>
        <span class="w-px h-5 bg-sage"></span>
      </div>

      <h1 class="font-serif text-forest text-4xl lg:text-5xl leading-tight mb-6">
        {{ page_item.title }}
      </h1>

      <div class="divider mb-8 mx-auto"></div>

      <p class="text-gray-600 text-lg leading-relaxed mb-4">
        This page is on its way — we're putting the finishing touches to it.
      </p>
      <p class="text-gray-600 leading-relaxed mb-10">
        In the meantime, you're welcome to get in touch — I'm always happy to answer
        questions directly.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/#contact" class="inline-flex items-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors">
          <i data-lucide="calendar" class="w-4 h-4"></i>
          {{ content.hero.primaryButton }}
        </a>
        <a href="/" class="inline-flex items-center gap-2 border border-forest text-forest font-medium px-6 py-3 rounded hover:bg-forest hover:text-white transition-colors">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          Back to home
        </a>
      </div>

    </div>
  </section>
{% endif %}

{% include "site-footer.njk" %}
